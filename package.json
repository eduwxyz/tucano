{
  "name": "tucano",
  "version": "0.2.1",
  "private": true,
  "description": "Tucano: your team of AI agents on your computer, with scopes, approvals and budgets.",
  "homepage": "https://tucano.sh",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "server": "node out/main/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "sh scripts/dist.sh",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "install-app": "npm run dist && sh scripts/install-app.sh",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.11",
    "gsap": "^3.14.2",
    "smol-toml": "^1.9.1"
  },
  "build": {
    "appId": "dev.tucano.app",
    "productName": "Tucano",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eduwxyz",
        "repo": "tucano"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Tucano opens the Terminal for you when you ask it to."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "tucano-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Tucano"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "tucano",
      "artifactName": "tucano-linux-${arch}.${ext}",
      "maintainer": "Eduardo da Silva <eduwxyz@users.noreply.github.com>",
      "synopsis": "A team of AI agents on your computer",
      "description": "Tucano is a team of AI agents that lives on your computer. You talk to them in channels; they research, write, code and use your tools, and you decide how far each one goes. It runs on the Claude Code, Codex, OpenCode or Pi you already have."
    },
    "deb": {
      "recommends": [
        "gnome-keyring"
      ]
    },
    "extraResources": [
      {
        "from": "build/sounds",
        "to": "sounds"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
