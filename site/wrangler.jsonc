// The site: the pages in dist/ (made by build.mjs) served as static files, plus worker.js for the
// routes of code: /api/lista (the Tucano Pro waitlist), /api/push/* (the iPhone app's push relay,
// push.js) and /api/feedback, /api/surveys* (the app's feedback and surveys, feedback.js). Everything
// else never reaches the worker.
//   cd site && npx wrangler deploy
// which first runs build.mjs. The worker's secrets: SUPABASE_SECRET_KEY, TURNSTILE_SECRET, and for the
// push relay APNS_KEY, APNS_KEY_ID, APNS_TEAM_ID, PUSH_SEAL
// (`npx wrangler secret put <name>`).
{
  "name": "tucano-site",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // At most 60 notifications a minute per phone (push.js); per address, 5 feedbacks and 30 survey
  // answers a minute (feedback.js).
  "ratelimits": [
    { "name": "PUSH_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SURVEY_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "COMPANY_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
  ],
  // Daily at 04:00 UTC: feedback pictures older than 90 days are deleted (feedback.js, sweep).
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": { "SUPABASE_URL": "https://ykfspxqsoahrwrneqovc.supabase.co" },
  "routes": [
    { "pattern": "tucano.sh", "custom_domain": true }
  ]
}
